# Copy to .env and edit. All values are optional -- the app runs out of the
# box against an in-memory Qdrant and a deterministic local embedder, using an
# offline stub LLM when no API key is set.

# --- LLM ---
# Without this key the app uses an offline stub answer (fine for demoing the
# pipeline; set it for real, grounded answers from Claude).
ANTHROPIC_API_KEY=
# Default is claude-opus-5. Forced tool-use requires an Opus-5-class model.
ANTHROPIC_MODEL=claude-opus-5

# --- Vector store ---
# ":memory:" is embedded (no server). Point at the docker-compose instance for
# persistence: http://localhost:6333
QDRANT_URL=:memory:
QDRANT_COLLECTION=vuln_corpus

# --- Embeddings ---
# "hashing" (default, dependency-free) or "sentence-transformers".
VULNRAG_EMBEDDER=hashing
VULNRAG_EMBEDDING_MODEL=all-MiniLM-L6-v2
VULNRAG_EMBEDDING_DIM=384

# --- Retrieval ---
VULNRAG_TOP_K=6

# --- Azure / Defender connector (only for a live scan; scan_cli.py --sample
# needs none of these) ---
# Entra ID app registration (service principal) with Defender for Endpoint
# application permissions Vulnerability.Read.All and Machine.Read.All, admin
# consent granted. Use Key Vault for the secret in production.
AZURE_TENANT_ID=
AZURE_CLIENT_ID=
AZURE_CLIENT_SECRET=
