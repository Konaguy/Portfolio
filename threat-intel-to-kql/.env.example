# Copy to .env and edit. Without ANTHROPIC_API_KEY the tool uses the offline
# deterministic generator, so the extract -> generate -> validate pipeline runs
# end to end with no key (useful for demos and CI).

ANTHROPIC_API_KEY=
# Default claude-opus-5. Forced tool-use requires an Opus-5-class model.
ANTHROPIC_MODEL=claude-opus-5
TI2KQL_MAX_TOKENS=2000
# Set to 0 to allow tables outside the known Defender catalog.
TI2KQL_STRICT_TABLES=1
